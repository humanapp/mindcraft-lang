{
  "name": "@mindcraft-lang/sim",
  "description": "Ecosystem Simulation App for Mindcraft",
  "version": "1.2.7",
  "private": true,
  "type": "module",
  "author": "humanapp",
  "license": "MIT",
  "keywords": [
    "phaser",
    "react",
    "vite",
    "typescript",
    "kode",
    "kodu",
    "project-spark",
    "sklanch",
    "sandbox",
    "simulation",
    "creative-coding",
    "game-development",
    "stem",
    "education",
    "learning",
    "coding",
    "programming",
    "games",
    "game-maker"
  ],
  "scripts": {
    "predev": "npm run build --prefix ../../packages/core",
    "dev": "vite --config vite/config.dev.mjs --force",
    "prebuild": "npm run install:packages --prefix ../.. && npm run build:deps && tsc --build tsconfig.refs.json",
    "build": "vite build --config vite/config.prod.mjs",
    "pregenerate:ambient": "npm run generate:ambient --prefix ../../packages/core",
    "generate:ambient": "tsx --tsconfig scripts/tsconfig.json scripts/generate-ambient.ts",
    "clean": "rm -rf dist && rm -rf node_modules/.vite",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p lib/tsconfig.ambient.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p lib/tsconfig.json && tsc --noEmit -p extensions/tsconfig.json",
    "format": "biome format ./src --write",
    "build:deps": "node ../../scripts/build-packages.js .",
    "release:patch": "node ../../scripts/release.js patch --skip-deps",
    "release:minor": "node ../../scripts/release.js minor --skip-deps",
    "release:major": "node ../../scripts/release.js major --skip-deps"
  },
  "dependencies": {
    "@mindcraft-lang/app-host": "file:../../packages/app-host",
    "@mindcraft-lang/bridge-app": "file:../../packages/bridge-app",
    "@mindcraft-lang/core": "file:../../packages/core",
    "@mindcraft-lang/docs": "file:../../packages/docs",
    "@mindcraft-lang/ts-compiler": "file:../../packages/ts-compiler",
    "@mindcraft-lang/ui": "file:../../packages/ui",
    "lucide-react": "^0.561.0",
    "miniplex": "^2.0.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.28.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
